# ---------- 3rdparty：只保留 mongoose 源码 ----------
# 归档包不入库
/3rdparty/*.tar.gz
# 参考资料不入库
/3rdparty/EngSketchPad-*/
# mongoose 只保留顶层核心文件，忽略示例/测试子目录
/3rdparty/mongoose-7.23/*/
# nlohmann/json：只跟踪 vendored 单头文件与许可证，其余一律忽略
/3rdparty/json-3.12.0/
/3rdparty/nlohmann/*
!/3rdparty/nlohmann/json.hpp
!/3rdparty/nlohmann/LICENSE.MIT
# 本地浏览器自动化工具不入库
/3rdparty/edgedriver_win64/
/3rdparty/edgedriver_win64.zip

# ---------- 构建日志 ----------
/build_log.txt

# ---------- 验证临时文件(claude.md 约定)----------
/temp/

# ---------- 前端依赖与产物 ----------
/web/*/node_modules/
/web/*/dist/

# Wavefront 模型也是 .obj，不能当成编译产物忽略
!/www/v1/eph205/**/*.obj

# ---------- CEF 二进制(约 260 MB,不入库) ----------
/3rdparty/cef-109/

# ---------- 运行期数据 ----------
/data/
# ---------- 客户端打包产物 ----------
/dist/
