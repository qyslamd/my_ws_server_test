# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd.exe 的 ^ 续行会失效
*.bat text eol=crlf

# C/C++ 源码保持 LF（mongoose 原样）
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
*.tar.gz binary